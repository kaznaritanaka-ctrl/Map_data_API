{
  "name": "map-data-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply maps --local",
    "db:remote": "wrangler d1 migrations apply maps --remote",
    "seed:dev": "node scripts/seed-dev.mjs && wrangler d1 execute maps --local --file .wrangler-seed.sql && wrangler r2 object put maps-data/geojson/99999.json --local --file .wrangler-seed.geojson"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
